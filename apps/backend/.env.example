# Ambiente: development | test | production
NODE_ENV=development

# Porta da API
PORT=3333

# Origem permitida pelo CORS (endereço do front-end)
CORS_ORIGIN=http://localhost:5173

# Conexão com o PostgreSQL do docker-compose
DATABASE_URL=postgresql://sigaa:sigaa@localhost:5432/sigaa

# Banco isolado usado pelos testes de integração (criado pelo docker-compose)
TEST_DATABASE_URL=postgresql://sigaa:sigaa@localhost:5432/sigaa_test

# Segredo para assinar os tokens JWT (mínimo de 32 caracteres).
# Em produção, gere um valor aleatório, ex.: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=troque-este-segredo-de-desenvolvimento-por-um-aleatorio

# Validade do token em segundos (padrão: 1 hora)
JWT_EXPIRES_IN_SECONDS=3600
